{
  "name": "otzaria-linker",
  "version": "2.0.0-alpha.0",
  "private": true,
  "description": "כלי אופליין ליצירה, עריכה, ייבוא וייצוא של קישורים בין ספרים לספריית אוצריא",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/package-release.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build && playwright test",
    "test:legacy": "playwright test tests/e2e/legacy-baseline.spec.ts",
    "check": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "26.6.6",
    "@types/sql.js": "1.4.11",
    "fast-check": "4.10.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.1.0"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "fflate": "0.8.3",
    "preact": "11.2.0",
    "sql.js": "1.16.0",
    "zstd-wasm-decoder": "0.2.3"
  }
}
